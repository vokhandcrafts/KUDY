{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Даследчы Case case/v1",
  "description": "25 §7: аўтар захоўвае Case — case_id, пытанне/тэма, фільтры, спіс кандыдатаў і яўна адабраныя fragment_id з іх рэвізіямі. Фільтры — 25 §7: назва тэмы, людзі/арганізацыі, раёны і неабавязковы прамежак гадоў. Адбор не запускае другі ўзровень аўтаматычна; праз абнаўленне крыніц выбар пазначаецца састарэлым — састарэласць і рэвізіі трымае сховішча (G19.05/G19.06), гэтая схема фіксуе толькі форму запісу. Празнаякасць Case — чалавечая праца; ніводны запіс тут не мае статусу approved.",
  "type": "object",
  "required": ["case_id", "question", "filters", "candidates", "selected"],
  "additionalProperties": false,
  "properties": {
    "case_id": { "type": "string", "pattern": "^[a-z0-9._-]{1,64}$" },
    "question": { "type": "string", "minLength": 1 },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "entities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "districts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "year_from": { "type": "integer", "minimum": 1 },
        "year_to": { "type": "integer", "minimum": 1 }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "fragment_ids"],
        "additionalProperties": false,
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "fragment_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fragment_id", "revision_id"],
        "additionalProperties": false,
        "properties": {
          "fragment_id": { "type": "string", "minLength": 1 },
          "revision_id": { "$ref": "#/$defs/sha256hex" }
        }
      }
    }
  },
  "$defs": {
    "sha256hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
