{
  "name": "kudy",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.19.0 <27",
    "npm": ">=10.9.8 <13"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "typecheck": "tsc --noEmit && tsc --noEmit -p services && tsc --noEmit -p core",
    "arch:check": "node tools/arch/arch-check.mjs --config .dependency-cruiser.cjs --baseline tools/arch/baseline.json core services contracts tools web app controllers components docs/run-model",
    "server:typecheck": "node tools/ci/deno-typecheck.mjs",
    "arch:baseline": "node tools/arch/arch-baseline.mjs --config .dependency-cruiser.cjs --baseline tools/arch/baseline.json core services contracts tools web app controllers components docs/run-model",
    "e2e:origin": "node tools/e2e-origin/serve-e2e-origin.mjs",
    "engine:parity": "node tools/engine-regressions/parity-count.mjs",
    "engine:regressions": "node tools/engine-regressions/check-regressions.mjs",
    "collector:dispatch": "node tools/collector/collector.mjs dispatch",
    "contracts:wire": "node tools/contracts/generate-wire-types.mjs",
    "contracts:wire:check": "node tools/contracts/generate-wire-types.mjs --check",
    "messages:generate": "node --experimental-strip-types tools/i18n/generate-messages.mjs",
    "messages:generate:check": "node --experimental-strip-types tools/i18n/generate-messages.mjs --check",
    "messages:check": "node --experimental-strip-types tools/i18n/check-messages.mjs",
    "ledger:baseline": "node tools/docs-ledger/ledger-baseline.mjs",
    "ledger:check": "node tools/docs-ledger/ledger-check.mjs",
    "tools:check": "node tools/validate/tools-check.mjs",
    "test": "node --test --experimental-strip-types --experimental-test-module-mocks --test-reporter=spec docs/run-model/run-model.test.mjs docs/agent-tasks/web/g10-dependency-guards.test.mjs \"test/*.test.mjs\" \"tools/arch/*.test.mjs\" \"tools/arch-surface/*.test.mjs\" \"tools/contracts/*.test.mjs\" \"tools/i18n/*.test.mjs\" \"tools/docs-ledger/*.test.mjs\" \"tools/build-bundle/*.test.mjs\" \"tools/metro-config/*.test.mjs\" \"tools/design/*.test.mjs\" \"tools/validate/*.test.mjs\" \"tools/publish-catalog/*.test.mjs\" \"tools/e2e-origin/*.test.mjs\" \"tools/collector/*.test.mjs\" \"tools/corpus/*.test.mjs\" \"tools/ci/*.test.mjs\" \"tools/simulate/*.test.mjs\" \"contracts/**/*.test.mjs\" \"spikes/**/*.test.mjs\" \"services/**/*.test.ts\" \"controllers/**/*.test.ts\" \"tests/discovery/*.test.ts\" \"tests/feedback/queue*.test.ts\" \"tests/feedback/ui*.test.ts\" \"tests/feedback/report*.test.ts\" \"tools/feedback-report/*.test.mjs\" \"core/**/*.test.ts\" \"web/**/*.test.ts\" \"supabase/**/*.test.ts\" && jest --config jest.config.js"
  },
  "dependencies": {
    "@expo-google-fonts/alegreya": "^0.4.2",
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/golos-text": "^0.4.2",
    "@maplibre/maplibre-react-native": "11.3.10",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "1.1.1",
    "expo-constants": "18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "8.0.12",
    "expo-location": "19.0.8",
    "expo-router": "6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "3.0.9",
    "expo-task-manager": "14.0.9",
    "lucide-react-native": "1.49.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-purchases": "10.9.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@testing-library/react-native": "13.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.4",
    "@types/react": "19.1.10",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "fetch-socks": "1.3.3",
    "jest": "29.7.0",
    "jest-expo": "54.0.18",
    "jsqr": "1.4.0",
    "playwright": "1.63.0",
    "pngjs": "3.4.0",
    "qrcode": "1.5.4",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
