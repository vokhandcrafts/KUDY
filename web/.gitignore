# Generated content trees: the web reads build-bundle output dropped here;
# no content copy is ever committed (implementation-rules 5). Root-anchored so
# lib/content/ (the readers) is never matched.
/content/
/public/content/
# QR print assets: generated by scripts/build-qr.ts, never tracked
# (implementation-rules 5).
/public/qr/
/node_modules/
/.next/
/out/
*.tsbuildinfo
