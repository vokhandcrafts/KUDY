{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Перакладны набор UI-паведамленняў, адна мова (G21.25)",
  "description": "Адзін запіс на кожны пераклад кананічнага арыгіналу са source.json (спека 2026-10-03-single-source-translations): значэнне з шабланавымі пазіцыямі ${name}, forms — толькі для запісаў з discreteForms, з тымі жа ключамі; reviewedSourceHash — адбітак праверанай версіі арыгіналу (роўны current sourceHash, інакш набор састарэлы); review — вынік праверкі; terminology — паходжанне тэрмінаў пры няпэўнасці (G21.27, issue #566): вырашаны пошук з поўным следам ці сумленны unresolved, які блакуе публікацыю запісу на гейце. Крыніцавая мова be перакладных набораў не мае — be-каталог праецыруецца са source.json. Правілы па-за схемай (невядомыя/дублыя ідэнтыфікатары, неспадзяванне хэша, неспадзяванне форм і параметраў, паўната следу terminology па відзе, выканальны код у радках) — у translations.mjs, кожная са сваім іменаваным правілам.",
  "type": "object",
  "additionalProperties": false,
  "required": ["translation_schema_version", "locale", "provenance", "records"],
  "properties": {
    "translation_schema_version": { "const": 1 },
    "locale": { "type": "string", "pattern": "^[a-z]{2}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reviewer", "evidence"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "reviewedSourceHash", "review"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[A-Za-z0-9_#-]+)+$",
            "maxLength": 120
          },
          "value": { "type": "string", "minLength": 1 },
          "forms": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[A-Za-z0-9_#-]+$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "reviewedSourceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome"],
            "properties": {
              "outcome": { "enum": ["approved", "unreviewed"] },
              "note": { "type": "string", "minLength": 1 }
            }
          },
          "terminology": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "kind", "reason"],
            "properties": {
              "status": { "enum": ["resolved", "unresolved"] },
              "kind": { "enum": ["looked-up", "reviewed-terminology", "reviewer-judgment"] },
              "source": { "type": "string", "minLength": 1 },
              "locator": { "type": "string", "minLength": 1 },
              "term": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        }
      }
    }
  }
}
