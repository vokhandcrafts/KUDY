{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FeedbackTarget (feedback_target_registry)",
  "description": "З 21 §5.1: {kind: guide, route_id, version, locale} або {kind: place, place_id, content_version, locale}. locale — мова выкарыстанага зместу, не мова прылады. Ацэнкі асобных Story і Collection у гэтым выпуску няма. Registry запаўняе publisher (G02.03 export → G02.04 → G16.01); імпартаваныя або выдуманыя ID адхіляюцца.",
  "oneOf": [
    {
      "type": "object",
      "required": ["kind", "route_id", "version", "locale"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "guide" },
        "route_id": { "$ref": "../schemas/identifier.schema.json" },
        "version": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 64 },
        "locale": { "enum": ["be", "en", "uk"] }
      }
    },
    {
      "type": "object",
      "required": ["kind", "place_id", "content_version", "locale"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "place" },
        "place_id": { "$ref": "../schemas/identifier.schema.json" },
        "content_version": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 64 },
        "locale": { "enum": ["be", "en", "uk"] }
      }
    }
  ]
}
