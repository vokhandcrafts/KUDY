{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Публічная праекцыя месца/падборкі (public.json)",
  "description": "Форма файлаў public/places/<place_id>/public.json і public/collections/<collection_id>/public.json — публічныя праекцыі з 21 §3.3. Толькі дазволеныя палі (additionalProperties false — закрыты слоўнік ёсць мяжа origin/namespace: імпарт не трапляе ў public-праекцыі, крытэрыі 2 і 4).",
  "oneOf": [
    {
      "type": "object",
      "required": ["place_id", "content_version", "name", "summary"],
      "additionalProperties": false,
      "properties": {
        "place_id": { "$ref": "../schemas/identifier.schema.json" },
        "content_version": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 64 },
        "name": { "$ref": "../schemas/localized-text.schema.json" },
        "summary": { "$ref": "../schemas/localized-text.schema.json" }
      }
    },
    {
      "type": "object",
      "required": ["collection_id", "content_version", "name", "description"],
      "additionalProperties": false,
      "properties": {
        "collection_id": { "$ref": "../schemas/identifier.schema.json" },
        "content_version": { "type": "string", "pattern": "^[0-9]+$", "maxLength": 64 },
        "name": { "$ref": "../schemas/localized-text.schema.json" },
        "description": { "$ref": "../schemas/localized-text.schema.json" }
      }
    }
  ]
}
