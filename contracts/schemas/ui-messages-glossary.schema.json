{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Зацверджаны глоссарый тэрмінаў UI (G21.19)",
  "description": "Версаляваны слоўнік тэрмінаў для перакладчыкаў: адзін запіс на тэрмін (guide/stop/walk/download/unavailable/purchase/restore — крытэрый 1 issue #543) са скарочаным тлумачэннем сэнсу, анкерамі на кананічныя запісы source.json (без дублявання іх тэксту/кантэксту — гл. крытэрый 1) і зацверджаным тэрмінам на кожную выпушчаную мову. Паходжанне кожнага тэрміну — terminology-след формы G21.27 (реф на $defs схемы перакладных набораў — адзінае вызначэнне, без перасказвання). Крыжавыя правілы (анкеры існуюць у source.json, кожная выпушчаная мова пакрытая, лакатар рэшаўляецца ў наборы гэтай мовы) — у glossary.mjs, кожнае са сваім іменаваным правілам.",
  "type": "object",
  "additionalProperties": false,
  "required": ["glossary_schema_version", "source_locale", "provenance", "entries"],
  "properties": {
    "glossary_schema_version": { "const": 1 },
    "source_locale": { "type": "string", "pattern": "^[a-z]{2}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reviewer", "evidence"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "meaning", "recordIds", "locales"],
        "properties": {
          "term": { "type": "string", "pattern": "^[a-z]+$" },
          "meaning": { "type": "string", "minLength": 1 },
          "recordIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "locales": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[a-z]{2}$" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["term", "provenance"],
              "properties": {
                "term": { "type": "string", "minLength": 1 },
                "provenance": {
                  "$ref": "ui-messages-translations.schema.json#/$defs/terminology"
                }
              }
            }
          }
        }
      }
    }
  }
}
