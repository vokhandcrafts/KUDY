# G00.03.a — толькі НАЗВЫ зменных, значэнні не захоўваюцца ў рэпазітары.
# Сакрэты сервера жывуць толькі ў env тэставага backend-асяроддзя (G00.03.c/#9).
# Кліент ніколі не атрымлівае ніводнай з серверных назваў ніжэй.

# --- Сервер (толькі backend env) ---
REVENUECAT_SECRET_API_KEY=   # Secret API key RevenueCat; ніколі не ў кліенце і не ў логах
REVENUECAT_PROJECT_ID=       # project/app у RevenueCat, да якога ідзе праверка правоў
REVENUECAT_BASE_URL=         # опцыянальны override хоста API; па змоўчанні афіцыйны
GRANT_ENVIRONMENT=           # sandbox | production; sandbox-права не адкрывае production-файл
GRANT_URL_SIGNING_KEY=       # ключ HMAC для кароткачасовых URL; ротэцыя — па-за спайкам
GRANT_PUBLIC_BASE_URL=       # знешняя база для lock_url і /files (напрыклад тэставы хост)
GRANT_URL_TTL_SECONDS=       # опцыянальна; па змоўчанні 600 (кароткачасовы URL)
GRANT_ENTITLEMENT_CACHE_TTL_SECONDS= # опцыянальна; па змоўчанні 86400 паводле 09 §5.1
GRANT_STORAGE_ROOT=          # опцыянальны root прыватных файлаў; па змоўчанні storage/private спайку
DEVICES_FILE=                # файл рэестра прылад (толькі хэшы сакрэтаў); шлях задаецца аператарам
GRANT_PUBLIC_ROOT=           # опцыянальны root публічных анонсаў; па змоўчанні storage/public спайку
PORT=                        # опцыянальна; па змоўчанні 8787

# --- Кліент (публічныя значэнні, не сакрэты) ---
REVENUECAT_PUBLIC_SDK_KEY=   # публічны SDK-ключ RevenueCat — адзіны ключ, які жыве ў кліенце
GRANT_SERVER_BASE_URL=       # база grant-сервера, да якога звяртаецца кліент
