    "commands": [
      "base=https://raw.githubusercontent.com/unicode-org/cldr-json/48.2.3/cldr-json",
      "curl -fsSL $base/<path> -o <target>   # per file, see files[].url; locales be,en,uk,de,es,fr,cs,sv",
      "sha256sum <downloaded files>   # hashes recorded in files[].sha256",
      "node .scratch/cldr-research/verify-plurals.mjs   # evaluator self-check vs official examples (scratch, not committed)",
      "grep -ril '<term>' <downloaded files>   # benchmark, case-insensitive substring over files[].path"
    ],
    "reproducibility": "each file pinned by tag URL + sha256; a re-run must reproduce the hashes while the tag exists"
  },
  "verification": {
    "method": "own minimal UTS#35 plural-rule evaluator (scratch script, not committed) validated against the official @integer/@decimal examples embedded in plurals.json/ordinals.json for the eight locales",
    "official_examples_total": 449,
    "official_examples_failed": 0,
    "note": "the evaluator only reads out categories for sample values; rule conditions and official examples are quoted verbatim from the data",
    "verified_findings": {
      "czech_integers": "one: 1; few: 2-4; other: 0, 5-20, 11/111 (1 in the last position of another ten), 21-25, 101, 1001, 1000000 — probe grid in probe.cs.cardinal.integers",
      "czech_fractions": "every value with visible fraction digits (v != 0) is many — including 1.0 and 2.0 (probe.cs.cardinal.decimals)",
      "belarusian_fractions": "x.0 forms follow the integer part (1.0 one, 2.0-4.0 few, 5.0 many); non-integer decimals (0.5, 1.1, 4.5) are other",
      "be_uk_divergence": "uk rules guard with v = 0, be rules operate on n: the string \"1.0\" is one in be but other in uk; the same holds for 2.0 (few vs other)",
      "french_spanish_millions": "exact millions (1000000, 2000000) are many in es and fr; 0 is one in fr but other in es; fr decimals 0.5/1.5 are one, 2.0 is other",
      "range_semantics": "UTS#35 ranges match integer values only (2..4 does not contain 2.5); the first version of the scratch evaluator matched them as float intervals and was corrected before the final probes — be \"2.5\" is other, cross-checked via ICU Intl.PluralRules"
    }
  },
